# Скопируйте в deploy/.env, если дефолтные порты заняты или нужны другие учётные данные.
# Без этого файла compose работает на значениях по умолчанию, перечисленных ниже.

# Порты на хосте. 5432 и 6379 часто заняты другими контейнерами, поэтому Postgres и
# Redis по умолчанию публикуются со сдвигом.
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=15432
REDIS_PORT=16379
MEMGRAPH_PORT=7687
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Учётные данные локального стека. Для публичного развёртывания задайте другие.
POSTGRES_USER=orbita
POSTGRES_PASSWORD=orbita
POSTGRES_DB=orbita
MINIO_ROOT_USER=orbita
MINIO_ROOT_PASSWORD=orbita-secret
