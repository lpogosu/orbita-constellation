# Записи встреч и их расшифровки не публикуются
*.mp4
*.txt

# Внутренние рабочие материалы: отчёты, промпты, аудит, архивы ассетов — не публикуются
_internal/
*.zip

# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
dist/
.vite/

# Секреты и локальное окружение
.env
.env.*
!.env.example
cert/

# IDE
.idea/
.vscode/
.DS_Store
Thumbs.db

# Сборка пакетов
*.egg-info/
build/
.tsbuildinfo
*.tsbuildinfo

# Локальные артефакты degraded mode: трассы и экспорт, записанные мимо MinIO
var/

# Отчёты о покрытии
.coverage
htmlcov/

# Рабочие копии инструментов (worktree) внутри репозитория
.*/worktrees/
